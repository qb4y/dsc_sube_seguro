    "ShareButton":   "design-system/src/components/ShareButton/index.tsx",
    "StatusRow":     "design-system/src/components/StatusRow/index.tsx",
    "VerdictCard":   "design-system/src/components/VerdictCard/index.tsx",
    "VehicleCard":   "design-system/src/components/VehicleCard/index.tsx",
